#include <Adafruit_NeoPixel.h>

#define PIN 7
#define NUM_LEDS 24
#define BUTTON 2

Adafruit_NeoPixel strip(NUM_LEDS, PIN, NEO_GRB + NEO_KHZ800);

//-----------------------------------------------------------
// FUNCIONES
//-----------------------------------------------------------

// Aleatorio entre 0 y 23
int numerorandom() {
  return random(0, NUM_LEDS);
}

// Encender un LED específico con un color
void encenderLED(int n, int r, int g, int b) {
  strip.clear();
  strip.setPixelColor(n, strip.Color(r, g, b));
  strip.show();
}

// Doble vuelta roja
void animacionRojaDoble() {
  for (int j = 0; j < 2; j++) {
    for (int i = 0; i < NUM_LEDS; i++) {
      encenderLED(i, 255, 0, 0);
      delay(50);
    }
  }
}

// Contar en rojo hasta el número aleatorio
void animacionRojaConteo(int objetivo) {
  for (int i = 0; i < objetivo; i++) {
    encenderLED(i, 255, 0, 0);
    delay(100);
  }
}

// Efecto cuando ganas (verde)
void animacionVictoria() {
  for (int i = 0; i < 3; i++) {
    strip.fill(strip.Color(0, 255, 0), 0, NUM_LEDS);
    strip.show();
    delay(300);

    strip.clear();
    strip.show();
    delay(300);
  }
}

// Efecto cuando pierdes (parpadeo rojo)
void animacionDerrota() {
  for (int j = 0; j < 3; j++) {
    strip.fill(strip.Color(255, 0, 0), 0, NUM_LEDS);
    strip.show();
    delay(500);

    strip.clear();
    strip.show();
    delay(500);
  }
}

//-----------------------------------------------------------
// SETUP
//-----------------------------------------------------------

void setup() {
  Serial.begin(9600);
  strip.begin();
  strip.show();
  pinMode(BUTTON, INPUT_PULLUP);
  randomSeed(analogRead(A0));
}

//-----------------------------------------------------------
// LOOP PRINCIPAL
//-----------------------------------------------------------

void loop() {

  // Lectura del potenciómetro
  int potValue = analogRead(A0);
  int ledSelected = map(potValue, 0, 1023, 0, NUM_LEDS - 1);

  Serial.print("LED seleccionado: ");
  Serial.println(ledSelected);

  // LED azul actual
  encenderLED(ledSelected, 0, 0, 255);
  delay(20);

  //-------------------------------------------------------
  // Si se presiona el botón
  //-------------------------------------------------------
  if (digitalRead(BUTTON) == LOW) {

    int num = numerorandom();
    Serial.print("Número aleatorio: ");
    Serial.println(num);

    // Efectos rojos
    animacionRojaDoble();
    animacionRojaConteo(num);

    delay(1000);

    //---------------------------------------------------
    // VICTORIA
    //---------------------------------------------------
    if (num == ledSelected) {
      Serial.println("¡Ganaste!");
      animacionVictoria();
    }
    //---------------------------------------------------
    // DERROTA
    //---------------------------------------------------
    else {
      animacionDerrota();
    }
  }
}
